{
  "version": 2,
  "functions": {
    "api/generate.py": {
      "includeFiles": "assets/**",
      "maxDuration": 60
    },
    "api/taxrate.py": {
      "maxDuration": 15
    },
    "api/sign.py": {
      "includeFiles": "{api/generate.py,assets/**}",
      "maxDuration": 60
    },
    "api/stripe.py": {
      "maxDuration": 30
    },
    "api/agent.py": {
      "maxDuration": 60
    },
    "api/webhook.py": {
      "includeFiles": "api/Parisienne-Regular.ttf"
    },
    "api/generate_receipt.py": {
      "includeFiles": "api/Parisienne-Regular.ttf"
    }
  },
  "rewrites": [
    { "source": "/api/:path*", "destination": "/api/:path*" },
    { "source": "/index.html", "destination": "/index.html" },
    { "source": "/luxury.html", "destination": "/luxury.html" },
    { "source": "/pricelist.html", "destination": "/pricelist.html" },
    { "source": "/pricelist-full.html", "destination": "/pricelist-full.html" },
    { "source": "/board.html", "destination": "/board.html" },
    { "source": "/today.html", "destination": "/today.html" },
    { "source": "/shop.html", "destination": "/shop.html" },
    { "source": "/proposal.html", "destination": "/proposal.html" },
    { "source": "/confirm.html", "destination": "/confirm.html" },
    { "source": "/gs-invoice.html", "destination": "/gs-invoice.html" },
    { "source": "/sw.js", "destination": "/sw.js" },
    { "source": "/manifest.webmanifest", "destination": "/manifest.webmanifest" },
    { "source": "/assets/:path*", "destination": "/assets/:path*" },
    { "source": "/", "destination": "/today.html" },
    { "source": "/((?!api/).*)", "destination": "/today.html" }
  ],
  "crons": [
    { "path": "/api/webhook", "schedule": "0 15 * * *" }
  ]
}
